{
  "name": "claude-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Widget de desktop que mostra o consumo da conta Claude Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "preparar": "electron --version",
    "test": "node --test",
    "icons": "node tools/make-icons.js",
    "autostart:on": "electron tools/autostart-cli.js --on",
    "autostart:off": "electron tools/autostart-cli.js --off",
    "autostart:status": "electron tools/autostart-cli.js --status",
    "empacotar": "node tools/pack.js"
  },
  "devDependencies": {
    "electron": "43.2.0"
  }
}
